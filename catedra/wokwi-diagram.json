{
  "version": 1,
  "author": "Cátedra Sistemas Embebidos / IoT ESP32",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": -80,
      "left": 180,
      "attrs": { "color": "red", "label": "Luminaria (GPIO 23)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -20,
      "left": 180,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 120,
      "left": 180,
      "attrs": { "color": "green", "label": "Pulsador Cochera (GPIO 32)" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:D23", "r1:1", "green", [ "v0" ] ],
    [ "r1:2", "led1:A", "green", [ "v0" ] ],
    [ "led1:C", "esp:GND.2", "black", [ "v0" ] ],

    [ "esp:D32", "btn1:1.l", "blue", [ "v0" ] ],
    [ "btn1:2.l", "esp:GND.2", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}

